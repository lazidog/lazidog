{
  "name": "@lazidog/proxy",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "WRANGLER_LOG_PATH=.wrangler/logs dotenv -e .env -- wrangler deploy",
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs dotenv -e .env -- wrangler dev --port 8788 --ip 0.0.0.0",
    "lint": "biome lint src --no-errors-on-unmatched",
    "format": "biome format src --write --no-errors-on-unmatched",
    "check": "biome check --write --no-errors-on-unmatched",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir dist --env=\"\"",
    "test": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "wasm-image-optimization": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@cloudflare/workers-types": "^4.20260213.0",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^10.0.0",
    "typescript": "^5.7.3",
    "wrangler": "4.65.0"
  }
}
