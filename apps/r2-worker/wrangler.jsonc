{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "r2-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-23",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "local-bucket",
    },
  ],
  "env": {
    "prod": {
      "name": "lazidog-r2-worker",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "lazidog",
        },
      ],
      "workers_dev": true,
    },
    "dev": {
      "name": "lazidog-r2-worker-dev",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "lazidog-dev",
        },
      ],
      "workers_dev": true,
    },
  },
}
