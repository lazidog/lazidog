    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lazidog/config": "workspace:*",
    "@lazidog/db": "workspace:*",
    "@lazidog/utils": "workspace:*",
    "@nestjs/common": "^10.4.9",
    "@nestjs/core": "^10.4.9",
    "@nestjs/platform-express": "^10.4.9",
    "cookie-parser": "^1.4.6",
    "dotenv-flow": "^4.1.0",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
