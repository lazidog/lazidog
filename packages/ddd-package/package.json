{
  "name": "@lazidog/ddd-package",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lazidog/lazidog.git"
  },
  "keywords": [
    "Domain-driven design",
