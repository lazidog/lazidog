{
  "name": "@lazidog/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "yarn prisma:gen && tsup --watch",
    "build": "yarn prisma:gen && tsup",
    "clean": "npx rimraf dist",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "prisma:db:push": "dotenv -e .env -- npx prisma db push",
    "prisma:reset": "dotenv -e .env -- npx prisma migrate reset",
    "prisma:fmt": "dotenv -e .env -- npx prisma format",
    "prisma:gen": "dotenv -e .env -- npx prisma generate",
    "prisma:migrate": "dotenv -e .env -- npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "seed": "dotenv -e .env -- tsx prisma/seed",
    "prisma:migrate:data": "scaffdog generate"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^6.2.1",
    "@prisma/client": "^6.2.1",
    "papaparse": "^5.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@quramy/prisma-fabbrica": "^2.2.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^9.0.5",
    "bcrypt": "^6.0.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.2.1",
    "rimraf": "^5.0.5",
    "scaffdog": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
