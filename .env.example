# Shared
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379

# DB (local compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lazidog?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lazidog?schema=public

# Auth cookies
COOKIE_DOMAIN=.lazidog.dev

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me_32_chars_min
JWT_ACCESS_TTL_SECONDS=900

# OAuth (Google)
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:4002/auth/google/callback

# Public base URLs (dev)
WEB_BASE_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:4002
API_BASE_URL=http://localhost:4000

# Next.js (public)
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:4002
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional seed
ADMIN_EMAIL=admin@lazidog.dev

# Observability (optional)
SENTRY_DSN=
