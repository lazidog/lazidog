# Shared
NODE_ENV=development

# DB (local compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lazidog?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lazidog?schema=public

# Auth cookies (set COOKIE_DOMAIN=.lazidog.dev in prod)
COOKIE_DOMAIN=
COOKIE_SECURE=false

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL_SECONDS=900

# Gateway -> API trust
GATEWAY_INTERNAL_SECRET=dev_gateway_secret_change_me

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4002/auth/google/callback

# Public base URLs (dev)
WEB_BASE_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:4002
GATEWAY_BASE_URL=http://localhost:4001
API_BASE_URL=http://localhost:4000

# Next.js (public)
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:4002
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:4001

# Optional seed
ADMIN_EMAIL=admin@lazidog.dev

# Observability (optional)
SENTRY_DSN=
