{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // resolveJsonModule allows you to import foo from './bar.json'. This only works when Node-style module resolution is used (like how node resolves files)
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "target": "es2022",
    "lib": ["es2023"]
  },
  "exclude": ["node_modules", "dist"]
}
